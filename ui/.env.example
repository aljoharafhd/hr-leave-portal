# HR Leave Portal — Frontend environment variables
# Copy this file to .env and fill in the values from your CDK stack outputs.
# All VITE_* vars are embedded at build time by Vite; no server-side secrets here.

# Cognito User Pool ID (from BackendStack output "UserPoolId")
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX

# Cognito App Client ID (from BackendStack output "UserPoolClientId")
VITE_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# REST API base URL (from BackendStack output "ApiUrl", e.g. https://xxxx.execute-api.us-east-1.amazonaws.com/prod/)
VITE_API_URL=https://xxxx.execute-api.us-east-1.amazonaws.com/prod/

# AgentCore proxy endpoint (HTTPS URL — API Gateway proxy or direct runtime URL).
# If left empty, the AI chat panel will show a "not configured" message.
VITE_AGENTCORE_ENDPOINT=https://xxxx.execute-api.us-east-1.amazonaws.com/prod/agent
