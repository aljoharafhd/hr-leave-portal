{
  "name": "hrAgent",
  "version": 2,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "agent",
      "build": "Container",
      "modelProvider": "Bedrock",
      "entrypoint": "main.py",
      "codeLocation": "app/agent",
      "dockerfile": "Dockerfile",
      "protocol": "HTTP",
      "envVars": [
        {"name" : "TABLE_NAME", "value" : "HrLeavePortalBackend-HrTable0964620C-964G0NZ7JU0J"},
        {"name" : "HR_EMAIL_TOPIC_ARN", "value":"arn:aws:sns:us-east-1:940779944047:HrLeavePortalNotifications-HrEmailTopic915EFFDB-8xVDszyoLAWD"},
        {"name" :"AWS_DEFAULT_REGION", "value":"us-east-1"}
      ]
    }
  ],
  "memories": [
    {
      "name": "agentMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "namespaceTemplates": [
            "/users/{actorId}/preferences"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "namespaceTemplates": [
            "/summaries/{actorId}/{sessionId}"
          ]
        },
        {
          "type": "EPISODIC",
          "namespaceTemplates": [
            "/episodes/{actorId}/{sessionId}"
          ],
          "reflectionNamespaceTemplates": [
            "/episodes/{actorId}"
          ]
        }
      ]
    }
  ]
}
